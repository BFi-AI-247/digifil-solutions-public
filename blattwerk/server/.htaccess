# Blattwerk
DirectoryIndex index.php
Options -Indexes
<FilesMatch "^(lib|ort)\.php$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  <FilesMatch "\.(woff2|css)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
